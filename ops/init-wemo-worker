#!/bin/sh
### BEGIN INIT INFO
# Provides:          wemo-worker
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Persistent WeMo inventory and background discovery
### END INIT INFO

set -eu
PATH=/sbin:/usr/sbin:/bin:/usr/bin
CONTROL=/usr/local/lib/wemo/supervisor.py
case "${1:-}" in
  start)
    install -d -m 0755 -o root -g root /run/wemo
    rm -f /etc/wemo-worker.disabled
    /usr/bin/python "$CONTROL" start
    ;;
  stop)
    touch /etc/wemo-worker.disabled
    /usr/bin/python "$CONTROL" stop
    ;;
  restart|force-reload)
    touch /etc/wemo-worker.disabled
    /usr/bin/python "$CONTROL" stop
    install -d -m 0755 -o root -g root /run/wemo
    rm -f /etc/wemo-worker.disabled
    /usr/bin/python "$CONTROL" start
    ;;
  status) /usr/bin/python "$CONTROL" status ;;
  *) echo "Usage: $0 start|stop|restart|force-reload|status" >&2; exit 2 ;;
esac
